;; cellar: Postgres from Clojure. Every query a .sql file; tables declared as
;; maps, and Postgres brought to what they say. One tree: source-code/cellar/.
{:paths ["source-code"]

 :deps
 {com.github.seancorfield/next.jdbc {:mvn/version "1.4.70"}
  org.postgresql/postgresql         {:mvn/version "42.7.14"}
  com.zaxxer/HikariCP               {:mvn/version "7.1.0"}
  ;; jsonb columns and Postgres's query plans
  metosin/jsonista                  {:mvn/version "1.0.2"}}

 :aliases
 {;; the tests:  clojure -X:test  (the Postgres ones need CELLAR_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; HikariCP logs through SLF4J; tests pick no logger
                       org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
